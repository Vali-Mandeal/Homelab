# ==============================================================================
# Proxmox Disaster Recovery Configuration
# ==============================================================================
# DR-specific settings. Shared infra config is loaded from homelab.env, which
# is always a sibling file in both layouts:
#   - Local dev: configs/homelab.env + configs/proxmox-dr.env in the same dir
#   - Remote (during deploy): both files SCPed into the same ${REMOTE_DIR}/config/
# ==============================================================================

_CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${_CONFIG_DIR}/homelab.env" ]]; then
    source "${_CONFIG_DIR}/homelab.env"
else
    echo "ERROR: Shared config not found at ${_CONFIG_DIR}/homelab.env"
    echo "Copy configs/homelab.env.example to configs/homelab.env and customize it."
    exit 1
fi
unset _CONFIG_DIR

# ==============================================================================
# VM TEMPLATES
# ==============================================================================

# Storage for base VM template (Proxmox local storage)
TEMPLATE_STORAGE="local-lvm"

# Ubuntu Cloud Image: defaults to the version pinned in proxmox-dr/lib/00-constants.sh.
# Uncomment to pin a different release than the one in constants:
# UBUNTU_CLOUD_IMAGE_URL="https://cloud-images.ubuntu.com/releases/24.04/release/ubuntu-24.04-server-cloudimg-amd64.img"
UBUNTU_TEMPLATE_ID="9000"

# Golden Image Template (cloned from base template, stored on NAS)
GOLDEN_IMAGE_TEMPLATE_ID="9100"

# ==============================================================================
# POWER MANAGEMENT
# ==============================================================================

# Wake-on-LAN (enables remote power-on via magic packet)
WOL_ENABLED="false"
