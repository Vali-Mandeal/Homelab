# ==============================================================================
# Docs Service Configuration
# ==============================================================================

# Container
CT_ID="your-ct-id"
CT_NAME="docs"
CT_IP="your-ct-ip"
CT_MEMORY="1024"
CT_CORES="1"
CT_DISK="8"
CT_BRIDGE="vmbr0"

# Documentation source (bind-mounted from Proxmox host)
PROXMOX_DOCS_PATH="/mnt/your-nas-private-mount/documentation"
CONTAINER_DOCS_PATH="mnt/docs"

# MkDocs serve settings
MKDOCS_PORT_START=8001       # First doc gets 8001, next 8002, etc.
MKDOCS_POLLING_INTERVAL=1    # Seconds between file change checks (SMB has no inotify)

# Traefik
DOCS_DOMAIN="docs.${TRAEFIK_DOMAIN}"
