# ==============================================================================
# Kasm (Browser Isolation) Service Configuration
# ==============================================================================

# Container
CT_ID="your-ct-id"
CT_NAME="kasm"
CT_IP="your-ct-ip"
CT_MEMORY="4096"
CT_CORES="2"
CT_DISK="16"
CT_BRIDGE="vmbr0"

# App source repo - fetched at deploy/update time by fetch_service_source.
# The .NET BrowserIsolation API lives in its own public repo; this CT just
# pulls the latest tarball, builds it, runs it.
SERVICE_REPO_URL="https://github.com/your-user/BrowserIsolation"
SERVICE_REPO_REF="main"
