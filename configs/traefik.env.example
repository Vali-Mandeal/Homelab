# ==============================================================================
# Traefik Service Configuration
# ==============================================================================

# Container
CT_ID="your-ct-id"
CT_NAME="traefik-proxy"
CT_IP="your-ct-ip"
CT_MEMORY="2048"
CT_CORES="1"
CT_DISK="4"
CT_BRIDGE="vmbr0"

# Traefik Secrets
CF_DNS_API_TOKEN="your-cloudflare-dns-api-token"
CLOUDFLARE_DNS_API_TOKEN="your-cloudflare-dns-api-token"
TRAEFIK_ACME_EMAIL="your-email@example.com"
TRAEFIK_DOMAIN="local.yourdomain.com"

# ==============================================================================
# Backend IPs - substituted into routes.yml at deploy time via envsubst
# ==============================================================================
# (PROXMOX_HOST_IP, NAS_PRIVATE_IP, GATEWAY_IP, PORTAINER_SERVER_IP come from
# homelab.env - no need to redeclare them here.)

JELLYFIN_CT_IP="your-jellyfin-ct-ip"
FRANKENSTEIN_IP="your-frankenstein-ip"
MEDIA_SERVER_VM_IP="your-media-server-vm-ip"
KASM_CT_IP="your-kasm-ct-ip"
MONITORING_CT_IP="your-monitoring-ct-ip"
HOMEPAGE_CT_IP="your-homepage-ct-ip"
NEXTCLOUD_VM_IP="your-nextcloud-vm-ip"
N8N_CT_IP="your-n8n-ct-ip"
SCRAPER_CT_IP="your-scraper-ct-ip"
DOCS_CT_IP="your-docs-ct-ip"
