# ==============================================================================
# n8n Service Configuration
# ==============================================================================

# Container
CT_ID="your-ct-id"
CT_NAME="n8n"
CT_IP="your-ct-ip"
CT_MEMORY="4096"
CT_CORES="2"
CT_DISK="20"
CT_BRIDGE="vmbr0"

# n8n
N8N_PORT="5678"
N8N_ENCRYPTION_KEY="your-encryption-key"

# Postgres
DB_PASSWORD="your-postgres-password"

# Backup storage (bind mount from Proxmox host - private NAS)
PROXMOX_PRIVATE_PATH="/mnt/your-nas-private-mount"
CONTAINER_PRIVATE_PATH="mnt/your-nas-private-mount"
