# ==============================================================================
# Jellyfin Service Configuration
# ==============================================================================

# Container
CT_ID="your-ct-id"
CT_NAME="jellyfin"
CT_IP="your-ct-ip"
CT_MEMORY="8192"
CT_CORES="4"
CT_DISK="16"
CT_BRIDGE="vmbr0"
CT_VLAN_TAG="10"

# Jellyfin runs on the public VLAN - set this to that VLAN's gateway
GATEWAY_IP="your-public-vlan-gateway"

# GPU
IGPU_PASSTHROUGH="true"

# Bind mounts (Proxmox host paths)
PROXMOX_MEDIA_PATH="your-proxmox-media-path"
PROXMOX_SSD_PATH="your-proxmox-ssd-path"

# Container mount points
CONTAINER_MEDIA_PATH="your-container-media-path"
CONTAINER_SSD_PATH="your-container-ssd-path"

# Jellyfin data on SMB (backups only - live DB stays local)
JELLYFIN_BACKUP_ROOT="your-jellyfin-backup-root"

