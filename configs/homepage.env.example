# ==============================================================================
# Homepage Service Configuration
# ==============================================================================

# Container
CT_ID="your-ct-id"
CT_NAME="homepage"
CT_IP="your-ct-ip"
CT_MEMORY="1024"
CT_CORES="1"
CT_DISK="8"
CT_BRIDGE="vmbr0"

# ==============================================================================
# Service IPs (used by services.yaml)
# ==============================================================================
# These complement homelab.env - service IPs not defined there go here.

MONITORING_CT_IP="your-monitoring-ct-ip"
JELLYFIN_CT_IP="your-jellyfin-ct-ip"
MEDIA_SERVER_VM_IP="your-media-server-vm-ip"
NEXTCLOUD_VM_IP="your-nextcloud-vm-ip"
N8N_CT_IP="your-n8n-ct-ip"
SCRAPER_CT_IP="your-scraper-ct-ip"
KASM_CT_IP="your-kasm-ct-ip"

# ==============================================================================
# Proxmox API (Homepage widget - homepage@pam token)
# Generated by proxmox-dr 15-api-users.sh - printed once during DR setup.
# ==============================================================================
PROXMOX_API_USER="user@pass"
PROXMOX_API_TOKEN_SECRET="your-proxmox-api-token-secret"

# ==============================================================================
# Grafana
# ==============================================================================
GRAFANA_ADMIN_PASSWORD="your-grafana-admin-password"

# ==============================================================================
# Media API Keys
# Find in each service's Settings → General → API Key
# ==============================================================================
JELLYFIN_API_KEY="your-jellyfin-api-key"
JELLYSEERR_API_KEY="your-jellyseerr-api-key"
RADARR_API_KEY="your-radarr-api-key"
SONARR_API_KEY="your-sonarr-api-key"
PROWLARR_API_KEY="your-prowlarr-api-key"

# ==============================================================================
# qBittorrent
# ==============================================================================
QBITTORRENT_USERNAME="admin"
QBITTORRENT_PASSWORD="your-qbittorrent-password"
