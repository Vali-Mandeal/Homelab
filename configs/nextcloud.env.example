# ==============================================================================
# Nextcloud - VM Configuration
# ==============================================================================

# VM
VM_ID="your-vm-id"
VM_NAME="nextcloud-vm"
VM_IP="your-vm-ip"
VM_MEMORY="8192"
VM_CORES="4"
VM_DISK="40"
VM_BRIDGE="vmbr0"
VM_VLAN_TAG="4"
VM_GATEWAY="your-public-vlan-gateway"
VM_SSH_PASSWORD="****"

# SSH Access
VM_SSH_ALIAS="false"
VM_ENABLE_SSH="false"
VM_ENABLE_ROOT_LOGIN="false"

# SMB mounts (user data on NAS - uses separate credentials for private shares)
SMB_HOST="your-nas-ip"
SMB_PRIVATE_USERNAME="****""
SMB_PRIVATE_PASSWORD="****""

SMB_SHARE_1="your-smb-share-1"
SMB_MOUNT_1="your-smb-mount-1"

SMB_SHARE_2="your-smb-share-2"
SMB_MOUNT_2="your-smb-mount-2"

# SMB mount (backups - uses proxmox.server from homelab.env)
SMB_SHARE_BACKUP="your-smb-backup-share"
SMB_MOUNT_BACKUP="your-smb-backup-mount"

SMB_UID="33"   # www-data UID — the official Nextcloud Docker image runs as www-data
SMB_GID="33"   # www-data GID
