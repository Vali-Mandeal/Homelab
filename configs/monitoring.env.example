# ==============================================================================
# Monitoring Stack Configuration
# ==============================================================================

# Container
CT_ID="your-ct-id"
CT_NAME="monitoring"
CT_IP="your-ct-ip"
CT_MEMORY="4096"
CT_CORES="2"
CT_DISK="50"
CT_BRIDGE="vmbr0"

# Grafana
GRAFANA_PORT="3001"
GRAFANA_ADMIN_PASSWORD="*****"

# Prometheus
PROMETHEUS_PORT="9090"

# Loki
LOKI_PORT="3100"

# Telegram Notifications (for Grafana alert webhooks)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-telegram-chat-id"

# Backup storage (bind mount from Proxmox host)
PROXMOX_SSD_PATH="/mnt/your-nas-public-ssd-mount"
CONTAINER_SSD_PATH="mnt/your-nas-public-ssd-mount"
