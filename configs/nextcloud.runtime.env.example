# ==============================================================================
# Nextcloud - Runtime config (Docker Compose .env on the VM)
# ==============================================================================
# deploy-services.sh copies this to /opt/nextcloud/.env on the VM.
# Keep the real file (nextcloud.runtime.env) gitignored - it carries secrets.

TZ=Europe/Bucharest

# Database
DB_USER=nextcloud
DB_PASSWORD=your-postgres-password
REDIS_PASSWORD=your-redis-password

# Nextcloud admin
NEXTCLOUD_ADMIN_USER=your-admin-user
NEXTCLOUD_ADMIN_PASSWORD=your-admin-password

# Domains (local via Traefik + public via Cloudflare tunnel)
TRUSTED_DOMAINS="nextcloud.local.${TRAEFIK_DOMAIN} nextcloud.${TRAEFIK_DOMAIN}"
NEXTCLOUD_URL=https://nextcloud.${TRAEFIK_DOMAIN}

# SMB mount paths (passed to Docker volumes)
MOUNT_PERSONAL=/mnt/your-personal-share
MOUNT_SHARED=/mnt/your-shared-share
DATA_DIR=/mnt/your-personal-share/NextCloudData

# Backup destination (on SMB)
BACKUP_DIR=/mnt/your-public-ssd-share/nextcloud
LOGS_DIR=/mnt/your-public-ssd-share/nextcloud/logs

# External storage mounts (comma-separated, format: DisplayName:container_path:user)
# Use * for all users. Each entry creates a Nextcloud external storage mount.
# Example: "Photos:/mnt/personal/Photos:admin,Music:/mnt/shared/Music:*"
NC_MOUNTS="Personal Files:/mnt/personal:admin,Shared Files:/mnt/shared:admin"

# OnlyOffice Document Server (dedicated document editing server)
ONLYOFFICE_URL=https://office.${TRAEFIK_DOMAIN}
ONLYOFFICE_JWT_SECRET=your-jwt-secret

# Local storage (on VM disk - fast I/O for DB and app files)
LOCAL_DB_ROOT=/opt/nextcloud/databases
DB_POSTGRES=/opt/nextcloud/databases/postgres
DB_REDIS=/opt/nextcloud/databases/redis
DB_NEXTCLOUD=/opt/nextcloud/databases/nextcloud
