# ==============================================================================
# Monitoring Agents - Host Registry
# ==============================================================================
# Per-host IPs and container/VM IDs. Sourced by monitoring-agents/deploy.sh.
# Copy to monitoring-agents.env and fill in values for your homelab.
# ==============================================================================

# Monitoring server (where agents push metrics/logs)
MONITORING_CT_IP="your-monitoring-ct-ip"

# Host IP map - every host that runs an Alloy agent.
# Add/remove entries to match your homelab.
declare -A HOST_IP=(
    [proxmox]="your-proxmox-ip"
    [traefik]="your-traefik-ct-ip"
    [homepage]="your-homepage-ct-ip"
    [kasm]="your-kasm-ct-ip"
    [cloudflare-tunnel]="your-cloudflare-tunnel-ct-ip"
    [nextcloud-vm]="your-nextcloud-vm-ip"
    [media-server]="your-media-server-vm-ip"
    [jellyfin]="your-jellyfin-ct-ip"
    [n8n]="your-n8n-ct-ip"
    [scraper]="your-scraper-ct-ip"
)

# LXC container IDs (Proxmox)
declare -A HOST_CT_ID=(
    [traefik]="your-traefik-ct-id"
    [homepage]="your-homepage-ct-id"
    [kasm]="your-kasm-ct-id"
    [cloudflare-tunnel]="your-cloudflare-tunnel-ct-id"
    [jellyfin]="your-jellyfin-ct-id"
    [n8n]="your-n8n-ct-id"
    [scraper]="your-scraper-ct-id"
)

# VM IDs (Proxmox)
declare -A HOST_VM_ID=(
    [nextcloud-vm]="your-nextcloud-vm-id"
    [media-server]="your-media-server-vm-id"
)

# File-based log glob per host (only for hosts where Alloy tails specific log files;
# omit for hosts that only collect Docker/journal logs).
declare -A HOST_LOG_PATH=(
    [jellyfin]="your-jellyfin-log-glob"
    [nextcloud-vm]="your-nextcloud-log-glob"
    [media-server]="your-media-server-log-glob"
)
