# ==============================================================================
# Cloudflare Tunnel Service Configuration
# ==============================================================================

# Container
CT_ID="your-ct-id"
CT_NAME="cloudflare-tunnel"
CT_IP="your-ct-ip"
CT_MEMORY="2048"
CT_CORES="1"
CT_DISK="4"
CT_BRIDGE="vmbr0"

# Tunnel (get token from Cloudflare Zero Trust dashboard)
TUNNEL_TOKEN="your-tunnel-token"
