# ==============================================================================
# ARR Stack (Media Automation) - VM Configuration
# ==============================================================================

# VM
VM_ID="your-vm-id"
VM_NAME="media-server"
VM_IP="your-vm-ip"
VM_MEMORY="16384"
VM_CORES="4"
VM_DISK="40"
VM_BRIDGE="vmbr0"
VM_VLAN_TAG="0"
VM_GATEWAY="your-public-vlan-gateway"
VM_SSH_PASSWORD="changeme"

# SSH Access
VM_SSH_ALIAS="true"          # Add SSH shortcut to local ~/.ssh/config (e.g. ssh media-server)
VM_ENABLE_SSH="true"         # Enable SSH server in the VM
VM_ENABLE_ROOT_LOGIN="true"  # Allow root login via SSH

# NFS mount (media files)
NFS_HOST="your-nas-ip"
NFS_SHARE="your-nfs-share"
NFS_MOUNT="your-nfs-mount"

# SMB mount (app configs & backups)
SMB_HOST="your-nas-ip"
SMB_SHARE="your-smb-share"
SMB_MOUNT="your-smb-mount"
# UID/GID owning the SMB mounts inside the VM. Defaults to NAS_SMB_UID
# (sourced from homelab.env before this file) so the arr-stack runs as the
# same UID the NAS uses for SMB auth, letting it read/write the shares.
SMB_UID="${NAS_SMB_UID}"
SMB_GID="${NAS_SMB_UID}"
