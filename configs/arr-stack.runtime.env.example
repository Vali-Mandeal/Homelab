# ==============================================================================
# Media Pipeline - Runtime config (Docker Compose .env on the VM)
# ==============================================================================
# deploy-services.sh copies this to /opt/arr/.env on the VM.

# --- General ---
TZ=Europe/Bucharest
PUID=1000
PGID=1000

# qBittorrent - change before first run
QBT_USER=admin
QBT_PASS=change_me_now

# --- Paths on the VM that point to your NAS mounts ---
# Media files are stored on the media mount
MEDIA_MOUNT=/mnt/your-public-media-mount

# App settings and configs are stored on the SSD server data mount
CONFIG_MOUNT=/mnt/your-public-ssd-share

# Media organization structure (on media mount)
MEDIA_ROOT=/mnt/your-public-media-mount/video
MOVIES_DIR=/mnt/your-public-media-mount/video/movies
SERIES_DIR=/mnt/your-public-media-mount/video/series
MUSIC_DIR=/mnt/your-public-media-mount/music

# Download management (on media mount)
DOWNLOADS_ROOT=/mnt/your-public-media-mount/downloads
DL_INCOMPLETE=/mnt/your-public-media-mount/downloads/incomplete
DL_COMPLETE=/mnt/your-public-media-mount/downloads/complete

# Application persistent storage (on SSD mount for fast access)
# This ensures settings, databases, and metadata survive container recreation
ARR_ROOT=/mnt/your-public-ssd-share/arr

# Backup directories (on SMB for persistence) - nightly backups stored here
BACKUP_RADARR=/mnt/your-public-ssd-share/arr/radarr/backups
BACKUP_SONARR=/mnt/your-public-ssd-share/arr/sonarr/backups
BACKUP_PROWLARR=/mnt/your-public-ssd-share/arr/prowlarr/backups
BACKUP_JELLYSEERR=/mnt/your-public-ssd-share/arr/jellyseerr/backups
BACKUP_QBITTORRENT=/mnt/your-public-ssd-share/arr/qbittorrent/backups

# Logs directory (on SMB for persistence)
LOGS_DIR=/mnt/your-public-ssd-share/arr/logs

# Local config storage (on local filesystem for reliability)
# All app configs stored locally, backed up nightly to SMB
LOCAL_DB_ROOT=/opt/arr/databases
DB_RADARR=/opt/arr/databases/radarr
DB_SONARR=/opt/arr/databases/sonarr
DB_PROWLARR=/opt/arr/databases/prowlarr
DB_JELLYSEERR=/opt/arr/databases/jellyseerr
DB_QBITTORRENT=/opt/arr/databases/qbittorrent

# Bootstrap directory for setup scripts and backups (on SSD mount)
BOOTSTRAP_DIR=/mnt/your-public-ssd-share/arr/bootstrap

# --- VPN (Gluetun + WireGuard-compatible provider) ---
# Generate a WireGuard config from your VPN provider with port-forwarding enabled.
VPN_WIREGUARD_PRIVATE_KEY=your-wireguard-private-key
VPN_SERVER_COUNTRIES=your-country

# --- Jellyseerr integration ---
JELLYSEERR_PORT=5055
