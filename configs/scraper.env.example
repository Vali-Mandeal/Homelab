# ==============================================================================
# Scraper Service Configuration
# ==============================================================================

# Container
CT_ID="your-ct-id"
CT_NAME="scraper"
CT_IP="your-ct-ip"
CT_MEMORY="8192"
CT_CORES="4"
CT_DISK="20"
CT_BRIDGE="vmbr0"

# Service
SCRAPER_PORT="666"

# Image - built inside the CT from WebScrapper.ScraperApi/Dockerfile in the
# fetched source tree (see SERVICE_REPO_URL below)
SCRAPER_IMAGE="webscrapper-scraper:latest"

# App source repo - fetched at deploy/update time by fetch_service_source
SERVICE_REPO_URL="https://github.com/your-user/WebScraper"
SERVICE_REPO_REF="main"

# Admin UI - co-located in the same CT, built from frontend/
UI_PORT="3000"
UI_IMAGE="scrapper-admin-ui:latest"
# Base URL the FE bundle uses to call the .NET ScraperApi.
# Baked into the JS bundle at build time via --build-arg VITE_API_URL.
SCRAPER_API_URL="http://${CT_IP}:${SCRAPER_PORT}"

# Telegram - scraper-specific bot, distinct from monitoring's
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_DEFAULT_CHAT_ID="your-telegram-chat-id"
