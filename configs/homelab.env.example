# ==============================================================================
# Homelab Shared Configuration
# ==============================================================================
# Shared infrastructure config used by both proxmox-dr and services.
# Copy this file to homelab.env and customize for your environment.
# DO NOT commit homelab.env to Git (it's in .gitignore)
# ==============================================================================

# ==============================================================================
# CONNECTION
# ==============================================================================

PROXMOX_HOST="your-proxmox-ip"
SSH_USER="root"
SSH_PORT="22"

# ==============================================================================
# NETWORK
# ==============================================================================

GATEWAY_IP="your-gateway-ip"
DNS_SERVERS="1.1.1.1 8.8.8.8"

PROXMOX_HOST_IP="your-proxmox-ip"
PROXMOX_HOSTNAME="pve"

# Portainer server (used by vm-service.sh to lock down agent firewall on VMs)
PORTAINER_SERVER_IP="your-portainer-server-ip"

# Traefik reverse proxy (referenced by services that need trusted_proxies)
TRAEFIK_CT_IP="your-traefik-ct-ip"

# ==============================================================================
# DOMAINS
# ==============================================================================

# Public domain - used for hostnames that are exposed via Cloudflare Tunnel.
# e.g. nextcloud.${PUBLIC_DOMAIN} → tunneled, reachable from the internet
PUBLIC_DOMAIN="homelab.example.com"

# Traefik (LAN) domain - full subdomain suffix for services on the LAN.
# Resolved by a wildcard A record on the local DNS resolver, pointing at Traefik.
# e.g. homepage.${TRAEFIK_DOMAIN}, n8n.${TRAEFIK_DOMAIN} - LAN-only
TRAEFIK_DOMAIN="local.${PUBLIC_DOMAIN}"

# Private Network (no VLAN tag)
PRIVATE_NETWORK_CIDR="your-private-network-cidr"
PRIVATE_NETWORK_BRIDGE="vmbr0"

# Public Network (requires VLAN tag)
PUBLIC_NETWORK_CIDR="your-public-network-cidr"
PUBLIC_NETWORK_BRIDGE="vmbr1"
PUBLIC_VLAN_TAG="your-vlan-tag"
PROXMOX_PUBLIC_IP="your-proxmox-public-ip"

# ==============================================================================
# STORAGE (NAS)
# ==============================================================================

NAS_PRIVATE_IP="your-nas-private-ip"
NAS_PUBLIC_IP="your-nas-public-ip"

# NFS Mount (public media - no authentication required)
NFS_PUBLIC_MEDIA_MOUNT="your-nfs-public-media-mount"
NFS_PUBLIC_MEDIA_SHARE_NAME="your-nfs-public-media-share-name"

# NFS export prefix on the NAS - full server path is
# ${NAS_PUBLIC_IP}:${NFS_EXPORT_BASE}/${NFS_PUBLIC_MEDIA_SHARE_NAME}.
# Default matches TrueNAS layout; QNAP/Synology vary. Set this to whatever
# `showmount -e ${NAS_PUBLIC_IP}` lists as the export base on your NAS.
NFS_EXPORT_BASE="/var/nfs/shared"

# SMB Mounts (server data - requires authentication)
SMB_PRIVATE_MOUNT="your-smb-private-mount"
SMB_PRIVATE_SHARE_NAME="your-smb-private-share-name"

SMB_PUBLIC_MOUNT="your-smb-public-mount"
SMB_PUBLIC_SHARE_NAME="your-smb-public-share-name"

# SMB Authentication
SMB_USERNAME="your-smb-username"
SMB_PASSWORD="your-smb-password"

# UID the NAS uses for SMB-authenticated writes. proxmox-dr adds this UID to
# /etc/subuid and /etc/subgid so unprivileged LXC containers can map it
# passthrough — services that need to write to SMB-mounted shares run as this
# UID inside the container. Individual services may override in their own
# config (e.g. Nextcloud runs as www-data UID 33 and doesn't need this).
NAS_SMB_UID="your-nas-smb-uid"

# ==============================================================================
# SSH
# ==============================================================================

SSH_PUBLIC_KEY_PATH="your-ssh-public-key-path"

# ==============================================================================
# DATABASES
# ==============================================================================

# MongoDB Atlas - used by scrapper-admin-api
# Format: mongodb+srv://user:pass@cluster.mongodb.net/WebScrapperV2
MONGODB_URI="mongodb+srv://..."

# ==============================================================================
# N8N
# ==============================================================================

# n8n API key - used by scraper/deploy.sh to upsert the WebScrapper workflow
# Generate in n8n UI: Settings → API → Create API Key
N8N_API_KEY="your-n8n-api-key"
