        <mxCell id="zone_users" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f4fd;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=13;fontStyle=1;verticalAlign=top;align=center;spacingTop=8;" value="Users (browser / sync clients / iOS)" vertex="1">
          <mxGeometry height="640" width="380" x="40" y="60" as="geometry" />
