          <mxGeometry height="80" width="340" x="60" y="220" as="geometry" />
        </mxCell>
        <mxCell id="user_lan" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;" value="&lt;b&gt;LAN browser&lt;/b&gt;&lt;br&gt;https://nextcloud.local.example.com&lt;br&gt;https://office.local.example.com&lt;br&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;via UniFi split-DNS → Traefik&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="340" x="60" y="320" as="geometry" />
        </mxCell>
        <mxCell id="user_sync" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;" value="&lt;b&gt;Desktop / mobile sync&lt;/b&gt;&lt;br&gt;Nextcloud client app&lt;br&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;WebDAV - same hosts as above&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="340" x="60" y="420" as="geometry" />
        </mxCell>
        <mxCell id="note_2fa" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5E0;strokeColor=#d6b656;fontSize=10;fontColor=#664400;align=left;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;Auth path&lt;/b&gt;&lt;br&gt;Username + password → TOTP (enforced)&lt;br&gt;Brute-force throttle on the Nextcloud side&lt;br&gt;trusted_proxies = Traefik only - preserves real IP" vertex="1">
          <mxGeometry height="80" width="340" x="60" y="540" as="geometry" />
        </mxCell>
        <mxCell id="zone_edge" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=12;fontStyle=1;verticalAlign=top;align=center;spacingTop=6;" value="TLS termination" vertex="1">
          <mxGeometry height="640" width="300" x="480" y="60" as="geometry" />
        </mxCell>
        <mxCell id="cf_tunnel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=11;" value="&lt;b&gt;Cloudflare Tunnel&lt;/b&gt;&lt;br&gt;CT 1xx · 10.0.10.x&lt;br&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;TLS terminated at Cloudflare edge&lt;br&gt;mTLS to connector&lt;br&gt;HTTP to VM over LAN&lt;/span&gt;" vertex="1">
          <mxGeometry height="120" width="240" x="500" y="130" as="geometry" />
        </mxCell>
        <mxCell id="traefik" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=11;" value="&lt;b&gt;Traefik&lt;/b&gt;&lt;br&gt;CT 1xy · 10.0.10.xy&lt;br&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;TLS via Let&#39;s Encrypt (DNS-01)&lt;br&gt;secure-headers middleware&lt;br&gt;HTTPS→HTTP redirect for cleartext&lt;/span&gt;" vertex="1">
          <mxGeometry height="120" width="240" x="500" y="310" as="geometry" />
        </mxCell>
        <mxCell id="edge_junction" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#999999;strokeWidth=2;fontSize=11;align=center;dashed=0;" value="&lt;b&gt;HTTP to VM&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Plain HTTP&lt;br&gt;over LAN&lt;br&gt;:8080 (NC)&lt;br&gt;:9980 (Office)&lt;/span&gt;" vertex="1">
          <mxGeometry height="170" width="160" x="540" y="450" as="geometry" />
        </mxCell>
        <mxCell id="zone_vm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;dashed=1;dashPattern=10 5;fontSize=14;fontStyle=1;verticalAlign=top;align=center;spacingTop=8;" value="VM 212 - nextcloud-vm · 10.0.20.xc · public VLAN" vertex="1">
          <mxGeometry height="950" width="900" x="890" y="10" as="geometry" />
        </mxCell>
        <mxCell id="zone_compose" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;dashed=1;dashPattern=4 4;fontSize=11;fontStyle=2;verticalAlign=top;align=center;spacingTop=4;fontColor=#555555;" value="Docker compose network (bridge)" vertex="1">
          <mxGeometry height="540" width="840" x="920" y="60" as="geometry" />
        </mxCell>
        <mxCell id="nextcloud_app" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#27AE60;strokeWidth=2;fontSize=11;" value="&lt;b&gt;nextcloud&lt;/b&gt; (container)&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;nextcloud:latest · Apache + PHP · UID 33 (www-data)&lt;br&gt;Host port 8080 → :80&lt;br&gt;overwriteprotocol=https · trusted_proxies=10.0.10.xy&lt;br&gt;HSTS · 2FA TOTP enforced · brute-force throttle&lt;/span&gt;" vertex="1">
          <mxGeometry height="130" width="380" x="940" y="150" as="geometry" />
        </mxCell>
        <mxCell id="onlyoffice" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#27AE60;strokeWidth=2;fontSize=11;" value="&lt;b&gt;onlyoffice&lt;/b&gt; (container)&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;onlyoffice/documentserver:latest&lt;br&gt;Host port 9980 → :80&lt;br&gt;JWT_SECRET shared with Nextcloud&lt;br&gt;Document Server - WOPI editor host&lt;br&gt;&lt;font color=&quot;#5C2D85&quot;&gt;Browser also fetches editor JS directly from&lt;br&gt;office.example.com / .local - separate Traefik+CF route&lt;/font&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="130" width="380" x="1360" y="150" as="geometry" />
        </mxCell>
        <mxCell id="db" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2980B9;strokeWidth=2;fontSize=11;" value="&lt;b&gt;db&lt;/b&gt;&amp;nbsp;- Postgres 16&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;postgres:16-alpine&lt;br&gt;Internal :5432 (no published port)&lt;br&gt;Stores users, file metadata, shares, app data&lt;/span&gt;" vertex="1">
          <mxGeometry height="120" width="380" x="940" y="330" as="geometry" />
        </mxCell>
        <mxCell id="redis" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2980B9;strokeWidth=2;fontSize=11;" value="&lt;b&gt;redis&lt;/b&gt;&amp;nbsp;- Redis 7&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;redis:7-alpine · password-protected&lt;br&gt;Internal :6379 (no published port)&lt;br&gt;memcache.local + memcache.locking + distributed&lt;/span&gt;" vertex="1">
          <mxGeometry height="120" width="380" x="1360" y="330" as="geometry" />
        </mxCell>
        <mxCell id="local_vol" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#666666;strokeWidth=1;fontSize=10;align=center;" value="&lt;b&gt;Local volumes&lt;/b&gt; - /opt/nextcloud/databases/&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;postgres/ (UID 75) · redis/ (UID 666) · nextcloud/ (UID 45, /var/www/html)&lt;br&gt;Fast local I/O - DBs and Nextcloud install&lt;/span&gt;" vertex="1">
