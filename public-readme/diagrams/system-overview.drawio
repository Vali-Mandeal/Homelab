        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;" value="Homelab IaC - System Overview" vertex="1">
          <mxGeometry height="44" width="2320" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#666666;fontStyle=2;" value="One Proxmox host - 12 services across LXC, VM and Docker-in-LXC - two VLANs - four-tier storage - bash-orchestrated end-to-end" vertex="1">
          <mxGeometry height="24" width="2320" x="40" y="66" as="geometry" />
        </mxCell>
        <mxCell id="zone_external" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7e0;strokeColor=#d6b656;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=16;" value="External dependencies" vertex="1">
          <mxGeometry height="190" width="2320" x="40" y="120" as="geometry" />
        </mxCell>
        <mxCell id="ext_user" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;" value="&lt;b&gt;Internet user&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;LAN clients use split-horizon DNS so&lt;br&gt;traffic stays internal. Off-site clients&lt;br&gt;enter via the Cloudflare Tunnel.&lt;/span&gt;" vertex="1">
          <mxGeometry height="120" width="420" x="80" y="170" as="geometry" />
        </mxCell>
        <mxCell id="ext_cloudflare" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffeacc;strokeColor=#E67E22;strokeWidth=2;fontSize=11;" value="&lt;b&gt;Cloudflare&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Authoritative DNS for example.com&lt;br&gt;Zero-Trust Tunnel (mTLS to connector)&lt;br&gt;DNS API for ACME DNS-01 challenges&lt;/span&gt;" vertex="1">
          <mxGeometry height="120" width="420" x="540" y="170" as="geometry" />
        </mxCell>
        <mxCell id="ext_le" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffeacc;strokeColor=#E67E22;strokeWidth=2;fontSize=11;" value="&lt;b&gt;Let&#39;s Encrypt CA&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Issues wildcard *.local.example.com&lt;br&gt;90-day cert, auto-renewed by Traefik&lt;br&gt;DNS-01 challenge - no port 80 needed&lt;/span&gt;" vertex="1">
          <mxGeometry height="120" width="420" x="1000" y="170" as="geometry" />
        </mxCell>
        <mxCell id="ext_apis" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" value="&lt;b&gt;External APIs consumed by services&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Telegram Bot API - scraper + monitoring alerts&lt;br&gt;SMTP relay - nextcloud, scraper notifications&lt;br&gt;MongoDB Atlas - WebScraper persistence&lt;br&gt;WireGuard VPN provider - Media Pipeline egress&lt;/span&gt;" vertex="1">
          <mxGeometry height="120" width="430" x="1460" y="170" as="geometry" />
        </mxCell>
        <mxCell id="ext_github" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" value="&lt;b&gt;GitHub source&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;BrowserIsolation - source repo&lt;br&gt;WebScraper - source repo&lt;br&gt;IaC fetches tarballs at deploy time;&lt;br&gt;apps live in their own public repos.&lt;/span&gt;" vertex="1">
          <mxGeometry height="120" width="390" x="1930" y="170" as="geometry" />
        </mxCell>
        <mxCell id="zone_edge" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f4fd;strokeColor=#2980B9;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=16;" value="On-premise network - UniFi" vertex="1">
