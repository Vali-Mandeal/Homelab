        <mxCell id="edge_gateway" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;" value="&lt;b&gt;Gateway / Router&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Dream Machine Pro Max&lt;br&gt;IDS/IPS, VPN, firewall, local DNS&lt;/span&gt;" vertex="1">
