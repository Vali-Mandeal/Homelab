        <mxCell id="be_jellyfin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#27AE60;strokeWidth=2;fontSize=10;" value="&lt;b&gt;jellyfin&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;native LXC · :8096&lt;br&gt;10.0.20.bg&lt;br&gt;jellyfin.local.example.com&lt;/span&gt;" vertex="1">
