        </mxCell>
        <mxCell id="be_frankenstein" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#27AE60;strokeWidth=2;fontSize=10;" value="&lt;b&gt;frankenstein&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;general-purpose port-forward host&lt;br&gt;FRANKENSTEIN_IP:80&lt;br&gt;frankenstein.local.example.com&lt;/span&gt;" vertex="1">
