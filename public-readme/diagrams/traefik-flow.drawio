        <mxCell id="be_nextcloud" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#27AE60;strokeWidth=2;fontSize=10;" value="&lt;b&gt;nextcloud&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;VM bf · :8080&lt;br&gt;10.0.20.bf&lt;br&gt;nextcloud.local.example.com&lt;br&gt;(uses secure-headers middleware)&lt;/span&gt;" vertex="1">
          <mxGeometry height="130" width="290" x="430" y="1270" as="geometry" />
        </mxCell>
        <mxCell id="be_onlyoffice" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#27AE60;strokeWidth=2;fontSize=10;" value="&lt;b&gt;onlyoffice&lt;/b&gt; (Document Server)&lt;br&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;same VM bg · :9980&lt;br&gt;10.0.20.bg&lt;br&gt;office.local.example.com&lt;/span&gt;" vertex="1">
          <mxGeometry height="130" width="290" x="740" y="1270" as="geometry" />
        </mxCell>
        <mxCell id="be_arr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#27AE60;strokeWidth=2;fontSize=10;" value="&lt;b&gt;Media Pipeline&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;VM bh - 10.0.20.bh&lt;br&gt;radarr :7878 · sonarr :8989&lt;br&gt;prowlarr :9696 · qbittorrent :8080&lt;br&gt;jellyseerr :5055&lt;br&gt;{radarr,sonarr,prowlarr,qbittorrent,jellyseerr}.local.example.com&lt;/span&gt;" vertex="1">
          <mxGeometry height="130" width="290" x="1050" y="1270" as="geometry" />
        </mxCell>
        <mxCell id="be_infra" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#27AE60;strokeWidth=2;fontSize=10;" value="&lt;b&gt;infra UIs&lt;/b&gt; (HTTPS · insecureSkipVerify)&lt;br&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;proxmox.local → 10.0.10.bi:8006&lt;br&gt;unifi.local → gateway:443&lt;br&gt;unas.local → NAS_PRIVATE_IP:443&lt;br&gt;portainer.local → 10.0.10.X:9443&lt;br&gt;traefik.local → api@internal · dashboard@internal&lt;/span&gt;" vertex="1">
