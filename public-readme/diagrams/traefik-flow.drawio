        <mxCell id="row2_label" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=2;fontColor=#666666;" value="&lt;b&gt;Public VLAN - 10.0.20.0/24&lt;/b&gt;  ·  Infrastructure UIs (mixed)" vertex="1">
