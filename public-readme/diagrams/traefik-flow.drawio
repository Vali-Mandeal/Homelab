        <mxCell id="e_dynamic_load" edge="1" parent="1" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#27AE60;strokeWidth=2;fontSize=10;fontColor=#1B5E20;entryX=0.85;entryY=1;entryDx=0;entryDy=0;" target="router" value="watch=true · hot reload">
