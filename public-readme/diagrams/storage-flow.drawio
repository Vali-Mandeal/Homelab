<mxfile host="app.diagrams.net" agent="Claude">
  <diagram name="Storage" id="storage-flow">
    <mxGraphModel dx="2560" dy="872" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" value="Storage tiers and data flow" vertex="1">
          <mxGeometry height="30" width="1020" x="40" y="10" as="geometry" />
        </mxCell>
        <mxCell id="apps" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=8;" value="&lt;b&gt;Live workloads&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px;color:#555;&#39;&gt;Proxmox · LXCs · VMs · all services&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="320" x="700" y="60" as="geometry" />
        </mxCell>
        <mxCell id="hot" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;spacing=10;verticalAlign=top;" value="&lt;b&gt;HOT&lt;/b&gt; · Samsung 9100 PRO NVMe 1 TB&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: rgb(85, 85, 85);&quot;&gt;PCIe 5.0 x4 · in the Proxmox server box&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Proxmox · LXC rootfs · VM disks · /opt/&amp;lt;service&amp;gt;&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size: 9px; color: rgb(136, 136, 136); font-style: italic;&quot;&gt;intentionally non-redundant - recoverable from IaC + warm-fast&lt;/span&gt;" vertex="1">
          <mxGeometry height="120" width="600" x="60" y="60" as="geometry" />
        </mxCell>
        <mxCell id="warm_fast" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=10;verticalAlign=top;" value="&lt;b&gt;WARM-fast&lt;/b&gt; · Samsung 870 EVO 1 TB SATA SSD&lt;br&gt;&lt;span style=&#39;font-size:10px;color:#555;&#39;&gt;in UNAS Pro · dedicated to server-app state&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#39;font-size:11px;&#39;&gt;mounted as /mnt/backups (SMB, authed)&lt;br&gt;nightly tarballs from every stateful service · 7-day retention&lt;br&gt;Postgres dumps · service logs · Grafana dashboards · etc.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#39;font-size:11px;color:#0a6;font-style:italic;&#39;&gt;★ IaC + this tier = full server recovery&lt;/span&gt;" vertex="1">
          <mxGeometry height="160" width="600" x="60" y="220" as="geometry" />
        </mxCell>
        <mxCell id="warm_cap" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=10;verticalAlign=top;" value="&lt;b&gt;WARM-capacity&lt;/b&gt; · 3× Seagate Exos X18 16 TB · RAID 5&lt;br&gt;&lt;span style=&#39;font-size:10px;color:#555;&#39;&gt;in UNAS Pro · ~32 TB usable · 3 free bays for expansion&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#39;font-size:11px;&#39;&gt;/mnt/media (NFS, anonymous)  →  Jellyfin · Media Pipeline&lt;br&gt;/mnt/private (SMB, authed)  →  docs · Nextcloud · personal&lt;br&gt;/mnt/personal_data · /mnt/shared_data (SMB)  →  Nextcloud user data&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#39;font-size:9px;color:#888;font-style:italic;&#39;&gt;RAID 5: 1-disk fault tolerance, capacity prioritised over redundancy&lt;/span&gt;" vertex="1">
          <mxGeometry height="170" width="600" x="60" y="420" as="geometry" />
        </mxCell>
        <mxCell id="cold" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=10;verticalAlign=top;dashed=1;" value="&lt;b&gt;COLD (in development)&lt;/b&gt; · 3D-printed Ubuntu NAS&lt;br&gt;&lt;span style=&#39;font-size:10px;color:#555;&#39;&gt;DIY · separate physical box · scope and hardware TBD&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#39;font-size:11px;&#39;&gt;Goal: scheduled pull from warm-fast + warm-capacity&lt;br&gt;Open: drive count · RAID level · replication tool (rsnapshot / restic / zfs send) · cadence&lt;/span&gt;" vertex="1">
          <mxGeometry height="130" width="600" x="60" y="630" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;verticalAlign=top;fontSize=11;spacing=10;align=left;" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#39;font-size:11px;&#39;&gt;━━ solid: in production today&lt;br&gt;┄┄ dashed: planned / in development&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#39;font-size:11px;&#39;&gt;Tier colours:&lt;br&gt;&lt;span style=&#39;color:#b85450;&#39;&gt;■&lt;/span&gt; hot · live workloads&lt;br&gt;&lt;span style=&#39;color:#d6b656;&#39;&gt;■&lt;/span&gt; warm-fast · backups, restorable state&lt;br&gt;&lt;span style=&#39;color:#82b366;&#39;&gt;■&lt;/span&gt; warm-capacity · media, personal&lt;br&gt;&lt;span style=&#39;color:#6c8ebf;&#39;&gt;■&lt;/span&gt; cold (planned) · offsite-style replica&lt;/span&gt;" vertex="1">
          <mxGeometry height="280" width="320" x="820" y="420" as="geometry" />
        </mxCell>
        <mxCell id="e_apps_hot" edge="1" parent="1" source="apps" style="endArrow=classic;startArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;strokeWidth=2;" target="hot" value="">
